# Local development placeholders only. Never reuse these values in shared environments.
POSTGRES_DB=adora
POSTGRES_USER=adora
POSTGRES_PASSWORD=change_me_for_local_development
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://adora:change_me_for_local_development@127.0.0.1:5432/adora
REDIS_URL=redis://127.0.0.1:6379/0

# FastAPI
ADORA_ENVIRONMENT=development
ADORA_LOG_LEVEL=INFO
ADORA_CORS_ORIGINS=["http://localhost:3000","http://localhost:8081"]

# Browser-visible values. Do not place secrets in NEXT_PUBLIC_* or EXPO_PUBLIC_*.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

